# 3p Query (pattern_110): concept_university_seminary --[concept:academicprogramatuniversity_reverse]--> ? --[concept:academicfieldsuchasacademicfield]--> ? --[concept:academicfieldsuchasacademicfield]--> ?
# Machine IDs: anchor=concept_university_seminary
# Pattern: 110 (0=KG match, 1=GENOP inference)
# Expected Answers (17):
#   1. concept_academicfield_humanities
#   2. concept_academicfield_life_sciences
#   3. concept_academicfield_plant_pathology
#   4. concept_academicfield_pharmacology
#   5. concept_academicfield_meteorology
#   6. concept_academicfield_physiology
#   7. concept_academicfield_plant_physiology
#   8. concept_academicfield_human_sciences
#   9. concept_academicfield_environmental_sciences
#   10. concept_academicfield_ecology
#   ... and 7 more

SELECT ?answer ?e1 ?e2 WHERE {
  GENOP("List movies released on concept_university_seminary format. Return ONLY a JSON array of exact movie titles like ['The Matrix', 'Inception']. No explanations.",
        (?e1),
        <model:openrouter:deepseek/deepseek-chat>)
  GENOP("List movies or entities where {?e1} is their academicfieldsuchasacademicfield. Return ONLY a JSON array of exact names like ['Name 1', 'Name 2']. No explanations.",
        (?e2),
        <model:openrouter:deepseek/deepseek-chat>)
  ?e2 <http://nell.cs.cmu.edu/relation/concept_academicfieldsuchasacademicfield> ?answer .
}
