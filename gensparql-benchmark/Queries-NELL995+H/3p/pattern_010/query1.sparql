# 3p Query (pattern_010): concept_visualizableattribute_diamond --[concept:buildingfeaturemadefrombuildingmaterial_reverse]--> ? --[concept:agentinvolvedwithitem_reverse]--> ? --[concept:agentcompeteswithagent_reverse]--> ?
# Machine IDs: anchor=concept_visualizableattribute_diamond
# Pattern: 010 (0=KG match, 1=GENOP inference)
# Expected Answers (1):
#   1. concept_city_article

SELECT ?answer ?e1 ?e2 WHERE {
  ?e1 <http://nell.cs.cmu.edu/relation/concept_buildingfeaturemadefrombuildingmaterial> <http://nell.cs.cmu.edu/entity/concept_visualizableattribute_diamond> .
  GENOP("List movies released on {?e1} format. Return ONLY a JSON array of exact movie titles like ['The Matrix', 'Inception']. No explanations.",
        (?e2),
        <model:openrouter:deepseek/deepseek-chat>)
  ?answer <http://nell.cs.cmu.edu/relation/concept_agentcompeteswithagent> ?e2 .
}
