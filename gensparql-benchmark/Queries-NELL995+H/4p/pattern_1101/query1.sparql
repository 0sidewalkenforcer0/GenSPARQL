# 4p Query (pattern_1101): concept_book_new --[concept:proxyfor_reverse]--> ? --[concept:subpartof_reverse]--> ? --[concept:proxyfor_reverse]--> ? --[concept:agentactsinlocation]--> ?
# Machine IDs: anchor=concept_book_new
# Pattern: 1101 (0=KG match, 1=GENOP inference)
# Expected Answers (1):
#   1. concept_geopoliticallocation_national

SELECT ?answer ?e1 ?e2 ?e3 WHERE {
  GENOP("List movies released on concept_book_new format. Return ONLY a JSON array of exact movie titles like ['The Matrix', 'Inception']. No explanations.",
        (?e1),
        <model:openrouter:deepseek/deepseek-chat>)
  GENOP("List movies released on {?e1} format. Return ONLY a JSON array of exact movie titles like ['The Matrix', 'Inception']. No explanations.",
        (?e2),
        <model:openrouter:deepseek/deepseek-chat>)
  ?e3 <http://nell.cs.cmu.edu/relation/concept_proxyfor> ?e2 .
  GENOP("List movies or entities where {?e3} is their agentactsinlocation. Return ONLY a JSON array of exact names like ['Name 1', 'Name 2']. No explanations.",
        (?answer),
        <model:openrouter:deepseek/deepseek-chat>)
}
