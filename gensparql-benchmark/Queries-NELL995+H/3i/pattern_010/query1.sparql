# 3i Query (pattern_010): (concept_stateorprovince_california --[concept:proxyfor_reverse]--> ?) ∩ (concept_buildingfeature_american --[concept:atlocation]--> ?) ∩ (concept_company_national --[concept:hasofficeincity]--> ?)
# Pattern: 010 (0=KG match, 1=GENOP inference)
# Expected Answers (3):
#   1. concept_city_chino
#   2. concept_city_laguna_beach
#   3. concept_city_buena_park

SELECT ?answer WHERE {
  ?answer <http://nell.cs.cmu.edu/relation/concept_proxyfor> <http://nell.cs.cmu.edu/entity/concept_stateorprovince_california> .
  GENOP("List movies or entities where concept_buildingfeature_american is their atlocation. Return ONLY a JSON array of exact names like ['Name 1', 'Name 2']. No explanations.",
        (?answer),
        <model:openrouter:deepseek/deepseek-chat>)
  <http://nell.cs.cmu.edu/entity/concept_company_national> <http://nell.cs.cmu.edu/relation/concept_hasofficeincity> ?answer .
}
