# up Query (pattern_001): ((concept_food_eggs --[concept:agriculturalproductcomingfromvertebrate]--> ?) ∪ (concept_bakedgood_sauce --[concept:fishservedwithfood_reverse]--> ?)) --[concept:animalsuchasfish_reverse]--> ?
# Pattern: 001 (0=KG match, 1=GENOP inference)
# Expected Answers (3):
#   1. concept_fish_exotic_fish
#   2. concept_fish_cutthroat_trout
#   3. concept_animal_head

SELECT ?answer ?mid WHERE {
  {
    <http://nell.cs.cmu.edu/entity/concept_food_eggs> <http://nell.cs.cmu.edu/relation/concept_agriculturalproductcomingfromvertebrate> ?mid .
  } UNION {
    ?mid <http://nell.cs.cmu.edu/relation/concept_fishservedwithfood> <http://nell.cs.cmu.edu/entity/concept_bakedgood_sauce> .
  }
  GENOP("List movies released on {{?mid}} format. Return ONLY a JSON array of exact movie titles like ['The Matrix', 'Inception']. No explanations.",
        (?answer),
        <model:openrouter:deepseek/deepseek-chat>)
}
