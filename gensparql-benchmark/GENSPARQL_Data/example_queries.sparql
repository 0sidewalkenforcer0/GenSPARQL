# 示例 SPARQL 查询

# 查询所有三元组 (限制10条)
PREFIX fbe: <http://freebase.com/entity/>
PREFIX fbr: <http://freebase.com/relation/>

SELECT ?subject ?predicate ?object
WHERE {
    ?subject ?predicate ?object .
}
LIMIT 10

