# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_clothing_t_shirt
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_clothing_jeans> <http://nell.cs.cmu.edu/relation/concept_clothingtogowithclothing> ?target .
}
