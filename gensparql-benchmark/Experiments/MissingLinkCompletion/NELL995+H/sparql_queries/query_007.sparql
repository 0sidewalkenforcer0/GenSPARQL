# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_personmexico_ncaa
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_sportsteam_florida_gulf_coast_eagles> <http://nell.cs.cmu.edu/relation/concept_agentcollaborateswithagent> ?target .
}
