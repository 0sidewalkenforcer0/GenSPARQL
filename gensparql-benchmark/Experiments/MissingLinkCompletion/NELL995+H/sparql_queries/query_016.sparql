# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_visualartform_exhibition
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_visualartist_andy_warhol> <http://nell.cs.cmu.edu/relation/concept_visualartistartform> ?target .
}
