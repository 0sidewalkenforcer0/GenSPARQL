# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_chemical_carbon
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_chemical_urea> <http://nell.cs.cmu.edu/relation/concept_chemicalistypeofchemical> ?target .
}
