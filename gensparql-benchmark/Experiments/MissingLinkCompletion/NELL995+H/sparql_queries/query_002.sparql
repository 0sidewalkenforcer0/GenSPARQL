# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_visualizablething_grenada
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_city_grenada> <http://nell.cs.cmu.edu/relation/concept_citylocatedincountry> ?target .
}
