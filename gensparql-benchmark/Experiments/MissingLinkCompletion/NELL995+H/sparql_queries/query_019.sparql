# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_animal_birds002
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_fish_parrots> <http://nell.cs.cmu.edu/relation/concept_animalpreyson> ?target .
}
