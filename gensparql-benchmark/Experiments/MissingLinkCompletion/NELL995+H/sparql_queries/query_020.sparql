# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_country_japan
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_company_denso> <http://nell.cs.cmu.edu/relation/concept_organizationheadquarteredincountry> ?target .
}
