# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_dateliteral_n2008
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_retailstore_clinic> <http://nell.cs.cmu.edu/relation/concept_atdate> ?target .
}
