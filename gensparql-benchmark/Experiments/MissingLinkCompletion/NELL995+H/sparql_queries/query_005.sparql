# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_bodypart_sac
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_bodypart_nerves001> <http://nell.cs.cmu.edu/relation/concept_bodypartcontainsbodypart> ?target .
}
