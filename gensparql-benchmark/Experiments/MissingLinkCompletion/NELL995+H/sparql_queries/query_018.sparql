# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_academicfield_microbiology
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_academicfield_biology> <http://nell.cs.cmu.edu/relation/concept_academicfieldsuchasacademicfield> ?target .
}
