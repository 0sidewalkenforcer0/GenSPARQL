# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_sportsequipment_skis
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_sport_ski> <http://nell.cs.cmu.edu/relation/concept_sportusesequipment> ?target .
}
