# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_university_institute
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_politicsissue_teaching> <http://nell.cs.cmu.edu/relation/concept_academicprogramatuniversity> ?target .
}
