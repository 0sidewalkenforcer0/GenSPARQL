# Standard SPARQL Query (1-hop Link Prediction)
# Expected Answer: concept_profession_special_education_teachers
# This query should return EMPTY (link is missing from train KG)

SELECT ?target WHERE {
  <http://nell.cs.cmu.edu/entity/concept_profession_staff> <http://nell.cs.cmu.edu/relation/concept_professionistypeofprofession> ?target .
}
