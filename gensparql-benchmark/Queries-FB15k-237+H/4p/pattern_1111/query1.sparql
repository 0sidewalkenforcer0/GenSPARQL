# 4p Query (pattern_1111): Animal9 --[←employment tenure.company]--> ? --[→leadership.organization]--> ? --[→sports team.colors]--> ? --[←educational institution.colors]--> ?
# Machine IDs: anchor=/m/0jbk9
# Pattern: 1111 (0=KG match, 1=GENOP inference)
# Expected Answers (8):
#   1. Norwich University (/m/06jk5_)
#   2. Valparaiso University (/m/03y5ky)
#   3. Adelphi University (/m/03205_)
#   4. George Mason University (/m/039d4)
#   5. University of Southern California (/m/065y4w7)
#   6. University of Colorado Boulder (/m/01qd_r)
#   7. Loyola University New Orleans (/m/02cvcd)
#   8. Willamette University (/m/02897w)

SELECT ?answer ?e1 ?e2 ?e3 WHERE {
  GENOP("List movies released on /m/0jbk9 format. Return ONLY a JSON array of exact movie titles like ['The Matrix', 'Inception']. No explanations.",
        (?e1),
        <model:openrouter:deepseek/deepseek-chat>)
  GENOP("List movies or entities where {?e1} is their organization role leaders organization leadership organization. Return ONLY a JSON array of exact names like ['Name 1', 'Name 2']. No explanations.",
        (?e2),
        <model:openrouter:deepseek/deepseek-chat>)
  GENOP("List movies or entities where {?e2} is their team colors. Return ONLY a JSON array of exact names like ['Name 1', 'Name 2']. No explanations.",
        (?e3),
        <model:openrouter:deepseek/deepseek-chat>)
  GENOP("List movies released on {?e3} format. Return ONLY a JSON array of exact movie titles like ['The Matrix', 'Inception']. No explanations.",
        (?answer),
        <model:openrouter:deepseek/deepseek-chat>)
}
