# 4p Query (pattern_1010): The Mary Tyler Moore Show --[→tv program.languages]--> ? --[←film.language]--> ? --[←film subject.films]--> ? --[→cause of death.people]--> ?
# Machine IDs: anchor=/m/0kfpm
# Pattern: 1010 (0=KG match, 1=GENOP inference)
# Expected Answers (5):
#   1. Julius Caesar (/m/041wm)
#   2. Robert F. Kennedy (/m/06hx2)
#   3. Mahatma Gandhi (/m/04xfb)
#   4. John F. Kennedy (/m/0d3k14)
#   5. Nicholas II of Russia (/m/05hks)

SELECT ?answer ?e1 ?e2 ?e3 WHERE {
  GENOP("List movies or entities where /m/0kfpm is their program languages. Return ONLY a JSON array of exact names like ['Name 1', 'Name 2']. No explanations.",
        (?e1),
        <model:openrouter:deepseek/deepseek-chat>)
  ?e2 <http://freebase.com/relation/forward_film_film_language> ?e1 .
  GENOP("List movies released on {?e2} format. Return ONLY a JSON array of exact movie titles like ['The Matrix', 'Inception']. No explanations.",
        (?e3),
        <model:openrouter:deepseek/deepseek-chat>)
  ?e3 <http://freebase.com/relation/forward_people_cause_of_death_people> ?answer .
}
