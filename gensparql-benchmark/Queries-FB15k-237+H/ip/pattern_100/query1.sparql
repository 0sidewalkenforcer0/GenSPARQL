SELECT ?answer ?mid WHERE {
  GENOP("List movies released on /m/03k9fj format. Return ONLY a JSON array of exact movie titles like ['The Matrix', 'Inception']. No explanations.",
        (?mid),
        <model:openrouter:deepseek/deepseek-chat>)
  ?mid <http://freebase.com/relation/forward_film_film_estimated_budget._measurement_unit_dated_money_value_currency> <http://freebase.com/entity/m_09nqf_United_States_Dollar> .
