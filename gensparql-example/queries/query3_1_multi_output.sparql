# Query 3.1: GENOP with 2 input variables and 3 output variables
# Demonstrates GENOP in context mode with multiple output variables
# Input: ?scientist and ?awardLabel (from BGP)
# Output: ?description, ?year, and ?category (generated by LLM)

PREFIX ex: <http://example.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?scientist ?prize ?description ?year ?category WHERE {
  ?person foaf:name ?scientist .
  ?person ex:receivedAward ?award .
  ?award rdfs:label ?awardLabel .
  GENOP("For the scientist {?scientist}. List all the prizes that he or she received. provide: (1) Prize name, (2) Prize year, and (3) the research category/field and (4) short description of the prize. Return as JSON object with fields 'prize name', 'year', 'category' and 'description'", 
        (?prize, ?year, ?category, ?description), 
        <model:openrouter:xiaomi/mimo-v2-flash:free>)
}

