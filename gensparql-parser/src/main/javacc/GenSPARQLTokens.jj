/**
 * GenSPARQL Token Definitions
 *
 * This JavaCC grammar defines the tokens and parsing rules for the
 * GENOP function extension to SPARQL.
 *
 * GENOP Syntax:
 *   GENOP("prompt", ?output, <model>)
 *   GENOP("prompt with {?x}", ?output, <model>, threshold)
 *   GENOP("prompt", (?var1, ?var2), <model>)
 *   GENOP("prompt", (?var1, ?var2), <model>, threshold)
 *
 * Modes:
 * - Base Mode: No input variables (placeholders), direct LLM call
 * - Context Mode: Prompt contains {?x} placeholders bound by surrounding patterns
 * - Multi-variable Output: Output parsed into multiple variable bindings
 * - Model Specification: Explicit model IRI
 * - Optional Threshold: Local similarity threshold θ for variables
 */

options {
    STATIC = false;
    UNICODE_INPUT = true;
    JAVA_UNICODE_ESCAPE = false;
    DEBUG_PARSER = false;
    DEBUG_TOKEN_MANAGER = false;
}

PARSER_BEGIN(GenSPARQLTokenParser)

package org.gensparql.parser.javacc;

import java.util.*;
import org.apache.jena.graph.Node;
import org.apache.jena.graph.NodeFactory;
import org.apache.jena.sparql.core.Var;
import org.gensparql.parser.element.ElementGenerate;

/**
 * JavaCC-generated parser for GenSPARQL GENOP function.
 */
public class GenSPARQLTokenParser {

    /**
     * Parse a GENOP function call from a string.
     */
    public static ElementGenerate parseGenOpFunction(String input) throws ParseException {
        GenSPARQLTokenParser parser = new GenSPARQLTokenParser(new java.io.StringReader(input));
        return parser.GenOpFunction();
    }
}

PARSER_END(GenSPARQLTokenParser)

/* ========== WHITESPACE AND COMMENTS ========== */

SKIP : {
    " " | "\t" | "\n" | "\r" | "\f"
}

SKIP : {
    <SINGLE_LINE_COMMENT: "#" (~["\n","\r"])* ("\n"|"\r"|"\r\n")? >
}

/* ========== KEYWORDS ========== */

TOKEN [IGNORE_CASE] : {
    <GENOP: "GENOP">
  | <TRUE: "true">
  | <FALSE: "false">
}

/* ========== PUNCTUATION ========== */

TOKEN : {
    <LPAREN: "(">
  | <RPAREN: ")">
  | <COMMA: ",">
}

/* ========== LITERALS ========== */

TOKEN : {
    <VAR: "?" <VARNAME>>
  | <#VARNAME: (<PN_CHARS_U> | ["0"-"9"]) (<PN_CHARS_U> | ["0"-"9"] | "\u00B7" | ["\u0300"-"\u036F"] | ["\u203F"-"\u2040"])*>
  | <#PN_CHARS_U: <PN_CHARS_BASE> | "_">
  | <#PN_CHARS_BASE: ["A"-"Z"] | ["a"-"z"] | ["\u00C0"-"\u00D6"] | ["\u00D8"-"\u00F6"] | ["\u00F8"-"\u02FF"] | ["\u0370"-"\u037D"] | ["\u037F"-"\u1FFF"] | ["\u200C"-"\u200D"] | ["\u2070"-"\u218F"] | ["\u2C00"-"\u2FEF"] | ["\u3001"-"\uD7FF"] | ["\uF900"-"\uFDCF"] | ["\uFDF0"-"\uFFFD"]>
}

TOKEN : {
    <STRING_LITERAL: "\"" (~["\"","\\","\n","\r"] | <ECHAR>)* "\"">
  | <#ECHAR: "\\" ["t","b","n","r","f","\\","\"","\'"]>
}

TOKEN : {
    <URI: "<" (~[">","<","\"","{","}","|","^","`","\\","\u0000"-"\u0020"])* ">">
}

TOKEN : {
    <INTEGER: (["-","+"])? (["0"-"9"])+>
  | <DECIMAL: (["-","+"])? (["0"-"9"])* "." (["0"-"9"])+>
  | <DOUBLE: (["-","+"])? ((["0"-"9"])+ "." (["0"-"9"])* <EXPONENT> | "." (["0"-"9"])+ <EXPONENT> | (["0"-"9"])+ <EXPONENT>)>
  | <#EXPONENT: ["e","E"] (["+","-"])? (["0"-"9"])+>
}

/* ========== GRAMMAR RULES ========== */

/**
 * Parse a GENOP function call.
 *
 * Syntax variants:
 *   GENOP("prompt", ?output, <model>)
 *   GENOP("prompt", ?output, <model>, threshold)
 *   GENOP("prompt", (?var1, ?var2), <model>)
 *   GENOP("prompt", (?var1, ?var2), <model>, threshold)
 */
ElementGenerate GenOpFunction() :
{
    String promptTemplate;
    List<Var> outputVars;
    Node modelNode;
    Double threshold = null;
    Map<String, Object> options = new HashMap<String, Object>();
}
{
    <GENOP> <LPAREN>
    promptTemplate = StringLiteral()
    <COMMA>
    outputVars = GenOpOutputVars()
    <COMMA>
    modelNode = URINode()
    [ <COMMA> threshold = ThresholdValue() ]
    <RPAREN>
    <EOF>
    {
        if (threshold != null) {
            options.put("threshold", threshold);
        }
        return new ElementGenerate(outputVars, promptTemplate, modelNode, options);
    }
}

/**
 * Parse output variables for GENOP function.
 * Can be a single variable or a tuple: (?var1, ?var2, ...)
 */
List<Var> GenOpOutputVars() :
{
    List<Var> vars = new ArrayList<Var>();
    Var v;
}
{
    (
        // Single variable
        v = Variable()
        { vars.add(v); }
    |
        // Tuple of variables
        <LPAREN>
        v = Variable() { vars.add(v); }
        ( <COMMA> v = Variable() { vars.add(v); } )*
        <RPAREN>
    )
    {
        return vars;
    }
}

/**
 * Parse threshold value (0.0 to 1.0).
 */
Double ThresholdValue() :
{
    Token t;
}
{
    (
        t = <DECIMAL>
        {
            return Double.parseDouble(t.image);
        }
    |
        t = <DOUBLE>
        {
            return Double.parseDouble(t.image);
        }
    |
        t = <INTEGER>
        {
            return Double.parseDouble(t.image);
        }
    )
}

/**
 * Parse a single variable.
 */
Var Variable() :
{
    Token t;
}
{
    t = <VAR>
    {
        // Remove the leading '?'
        String varName = t.image.substring(1);
        return Var.alloc(varName);
    }
}

/**
 * Parse a string literal (removing quotes).
 */
String StringLiteral() :
{
    Token t;
}
{
    t = <STRING_LITERAL>
    {
        // Remove surrounding quotes and unescape
        String s = t.image;
        s = s.substring(1, s.length() - 1);
        // Handle escape sequences
        s = s.replace("\\\"", "\"")
             .replace("\\\\", "\\")
             .replace("\\n", "\n")
             .replace("\\r", "\r")
             .replace("\\t", "\t");
        return s;
    }
}

/**
 * Parse a URI node (including angle brackets).
 */
Node URINode() :
{
    Token t;
}
{
    t = <URI>
    {
        // Remove angle brackets
        String uri = t.image.substring(1, t.image.length() - 1);
        return NodeFactory.createURI(uri);
    }
}
